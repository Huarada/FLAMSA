# Copy to .env (git-ignored) and fill in. Restart the app after changing it.
OPENAI_API_KEY=
# Format provider:model. Leave empty to use the offline template narrator (no language model).
# gpt-4.1-mini: good structured-output quality at low cost. Alternatives: openai:gpt-4.1 (stronger, ~5x cost),
# openai:gpt-4.1-nano (cheaper, weaker). Local Llama: ollama:llama3.1 (needs langchain-ollama).
PSI_LLM_MODEL=openai:gpt-4.1-mini

# Optional per-network-visitor copilot questions per UTC day; 0 = unlimited locally.
# Hosted settings are 4 per visitor and 100 globally. Counters reset on process restart.
PSI_DAILY_MODEL_LIMIT=0
PSI_DAILY_GLOBAL_LIMIT=0
